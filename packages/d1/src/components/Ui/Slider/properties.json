{
  "main": "{d.slider}",
  "height": "{ref.spacing.10}",
  "railHeight": "{ref.spacing.2}",
  "thumbSize": "{ref.spacing.6}",
  "thumbAreaSize": "{ref.spacing.12}",
  "thumbAreaShift": "{ref.spacing.1}",
  "markSize": "{ref.spacing.1}",
  "border-radius": "{sys.rounded.full}",
  "#rail": {
    "palette-background": "{sys.palette.primary}",
    "background-opacity": "{sys.opacity.scrim}"
  },
  "#track": {
    "palette-background": "{sys.palette.primary}",
    "background-opacity": "{sys.opacity.surface.medium}",
    "backdrop-filter": "{sys.blur.sm}"
  },
  "#label": {
    "paddingX": "{sys.spacing.xs}",
    "paddingY": "{sys.spacing.x}",
    "link|font": "{font.titleMedium}",
    "color": "{sys.palette.surface}",
    "color-opacity": "{sys.opacity.primary.high}",
    "background-color": "{sys.palette.scrim}",
    "background-opacity": "{sys.opacity.primary.medium}",
    "border-radius": "{sys.rounded.md}",
    "box-shadow": "{sys.shadow.md}",
    "backdrop-filter": "{sys.blur.md}"
  },
  "#thumb": {
    "palette-gradient": "{sys.palette.primary}",
    "gradient-opacity": "0",
    "border-radius": "{sys.rounded.full}",
    "after": {
      "palette-background": "{sys.palette.primary}",
      "background-opacity": "{sys.opacity.primary.high}",
      "box-shadow": "{sys.shadow.sm}",
      "backdrop-filter": "{sys.blur.md}"
    },
    "hover": {
      "gradient-opacity": "{sys.opacity.hover}"
    },
    "focus-visible": {
      "gradient-opacity": "{sys.opacity.hover}"
    },
    "active": {
      "gradient-opacity": "{sys.opacity.pressed}"
    }
  },
  "#mark": {
    "background-color": "{sys.palette.surface}",
    "background-opacity": "{sys.opacity.primary.high}",
    "border-radius": "{sys.rounded.full}"
  },
  "~selected": {
    "#rail": {
      "palette-background": "{sys.palette.primaryVariant}"
    },
    "#track": {
      "palette-background": "{sys.palette.primaryVariant}"
    },
    "#thumb": {
      "palette-gradient": "{sys.palette.primaryVariant}",
      "after": {
        "palette-background": "{sys.palette.primaryVariant}"
      }
    }
  },
  "disabled": {
    "#rail": {
      "palette-background": "{sys.palette.onSurface}",
      "background-opacity": "{sys.opacity.disabled}"
    },
    "#track": {
      "palette-background": "{sys.palette.onSurface}",
      "background-opacity": "{sys.opacity.surface.disabled}"
    },
    "#thumb": {
      "after": {
        "palette-background": "{sys.palette.onSurface}",
        "background-opacity": "{sys.opacity.primary.disabled}",
        "backdrop-filter": "{sys.blur.lg}"
      }
    }
  },
  "@@palette": "{palette}"
}