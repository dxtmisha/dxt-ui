{
  "main": "{d.inputFileItem}",
  "gap": "{sys.spacing.md}",
  "palette-gradient": "{sys.palette.primary}",
  "gradient-opacity": "0",
  "#thumbnail": {
    "background-color": "{sys.palette.onSurface}",
    "background-opacity": "{sys.opacity.overlay}"
  },
  "#body": {
    "gap": "{sys.spacing.x}"
  },
  "#label": {
    "link|font": "{font.bodyMediumEmphasized}"
  },
  "#caption": {
    "gap": "{sys.spacing.xs}",
    "link|font": "{font.bodySmall}",
    "color-opacity": "{sys.opacity.surface.medium}"
  },
  "#actions": {
    "gap": "{sys.spacing.x}",
    "align-items": "center",
    "flex-shrink": "0"
  },
  "#buttonCrop": {},
  "#buttonDelete": {},
  "#buttonRetry": {},
  "hover": {
    "gradient-opacity": "{sys.opacity.hover}"
  },
  "focus": {
    "gradient-opacity": "{sys.opacity.focus}"
  },
  "selected": {
    "palette-background": "{sys.palette.primaryVariant}",
    "background-opacity": "{sys.opacity.overlay}",
    "border-color": "{sys.palette.primary}",
    "border-opacity": "{sys.opacity.primary.high}"
  },
  "disabled": {
    "color": "{sys.palette.onSurface}",
    "color-opacity": "{sys.opacity.surface.disabled}",
    "background-opacity": "{sys.opacity.disabled}",
    "border-opacity": "calc({sys.opacity.outline} * {sys.opacity.surface.disabled})",
    "#label": {
      "color-opacity": "{sys.opacity.surface.disabled}"
    },
    "#caption": {
      "color-opacity": "{sys.opacity.surface.disabled}"
    }
  },
  "~appearance": {
    "~list": {
      "margin": "{sys.spacing.x}",
      "paddingX": "{layout.paddingX}",
      "paddingY": "{sys.spacing.xs}",
      "border-radius": "{sys.rounded.md}",
      "#thumbnail": {
        "width": "{ref.spacing.12}",
        "border-radius": "{sys.rounded.sm}"
      }
    },
    "~compact": {
      "paddingX": "{layout.paddingX}",
      "paddingY": "{sys.spacing.x}",
      "gap": "{sys.spacing.xs}",
      "#label": {
        "link|font": "{font.bodySmall}"
      }
    },
    "~tile": {
      "color": "{sys.palette.surface}",
      "width": "{ref.spacing.28}",
      "aspect-ratio": "1 / 1",
      "border-radius": "{sys.rounded.lg}",
      "#actions": {
        "background-color": "{sys.palette.scrim}",
        "background-opacity": "{sys.opacity.scrim}"
      }
    }
  },
  "~status": {
    "~uploading": {
      "border-color": "{sys.palette.primary}",
      "border-opacity": "{sys.opacity.surface.medium}"
    },
    "~uploaded": {
      "#caption": {
        "color": "{sys.palette.success}"
      }
    },
    "~error": {
      "border-color": "{sys.palette.error}",
      "border-opacity": "{sys.opacity.surface.high}",
      "#caption": {
        "color": "{sys.palette.error}",
        "color-opacity": "{sys.opacity.primary.high}"
      }
    },
    "~idle": {
      "_default": true
    }
  },
  "@@palette": "{palette}"
}