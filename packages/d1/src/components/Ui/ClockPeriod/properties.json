{
  "main": "{d.clockPeriod}",
  "borderWidth": "{sys.spacing.outline}",
  "color": "{sys.palette.onSurface}",
  "color-opacity": "{sys.opacity.surface.high}",
  "border-color": "{sys.palette.outline}",
  "border-opacity": "{sys.opacity.outline}",
  "border-radius": "{sys.rounded.md}",
  "background-color": "{sys.palette.surface}",
  "overflow": "hidden",
  "#item": {
    "link|font": "{font.labelLarge}",
    "border-color": "{sys.palette.outline}",
    "border-opacity": "{sys.opacity.outline}",
    "paddingX": "{sys.spacing.md}",
    "paddingY": "{sys.spacing.xs}",
    "min-width": "{ref.spacing.12}",
    "min-height": "{ref.spacing.10}",
    "palette-gradient": "{sys.palette.primary}",
    "gradient-opacity": "0",
    "focus-visible": {
      "outline": "{outline.md}"
    },
    "hover": {
      "gradient-opacity": "{sys.opacity.hover}"
    },
    "active": {
      "gradient-opacity": "{sys.opacity.pressed}"
    }
  },
  "~selected": {
    "color": "{sys.palette.primaryVariant}",
    "palette-background": "{sys.palette.primaryVariant}",
    "background-opacity": "{sys.opacity.selected}",
    "palette-gradient": "{sys.palette.primaryVariant}"
  },
  "~disabled": {
    "color": "{sys.palette.onSurface}",
    "color-opacity": "{sys.opacity.surface.disabled}",
    "border-opacity": "calc({sys.opacity.outline} * {sys.opacity.surface.disabled})",
    "#item": {
      "color": "{sys.palette.onSurface}",
      "color-opacity": "{sys.opacity.surface.disabled}",
      "background-opacity": "0",
      "border-opacity": "calc({sys.opacity.outline} * {sys.opacity.surface.disabled})"
    }
  },
  "@@palette": "{palette}"
}