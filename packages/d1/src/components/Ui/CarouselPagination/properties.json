{
  "main": "{d.carouselPagination}",
  "gap": "{sys.spacing.xs}",
  "focus-visible": {
    "outline": "{outline.md}"
  },
  "#item": {
    "color": "{sys.palette.onSurface}",
    "background-color": "{sys.palette.onSurface}",
    "background-opacity": "{sys.opacity.disabled}",
    "gradient": "var(--sys-color)",
    "gradient-opacity": "0",
    "border-radius": "{sys.rounded.full}",
    "selected": {
      "palette-background": "{sys.palette.onSurface}",
      "background-opacity": "{sys.opacity.primary.medium}"
    },
    "hover": {
      "gradient-opacity": "{sys.opacity.hover}"
    },
    "active": {
      "gradient-opacity": "{sys.opacity.pressed}"
    },
    "focus": {
      "outline": "{outline.md}"
    }
  },
  "#fraction": {
    "link|font": "{font.labelMedium}",
    "color": "{sys.palette.onSurface}",
    "color-opacity": "{sys.opacity.surface.high}",
    "palette-background": "{sys.palette.onSurface}",
    "background-opacity": "{sys.opacity.overlay}",
    "border-radius": "{sys.rounded.full}",
    "paddingX": "{sys.spacing.xs}",
    "paddingY": "{sys.spacing.x}",
    "backdrop-filter": "{sys.blur.sm}"
  },
  "#progress": {
    "background-color": "{sys.palette.onSurface}",
    "background-opacity": "{sys.opacity.overlay}",
    "border-radius": "{sys.rounded.full}",
    "height": "{ref.spacing.1}"
  },
  "#progressBar": {
    "palette-background": "{sys.palette.primary}",
    "background-opacity": "{sys.opacity.primary.high}",
    "border-radius": "{sys.rounded.full}"
  },
  "~type": {
    "~bullets": {
      "palette-background": "{sys.palette.onSurface}",
      "background-opacity": "{sys.opacity.overlay}",
      "border-radius": "{sys.rounded.full}",
      "paddingX": "{sys.spacing.xs}",
      "paddingY": "{sys.spacing.x}",
      "backdrop-filter": "{sys.blur.sm}",
      "#item": {
        "width": "{ref.spacing.2}",
        "height": "{ref.spacing.2}",
        "selected": {
          "width": "{ref.spacing.6}"
        }
      }
    },
    "~dots": {
      "palette-background": "{sys.palette.onSurface}",
      "background-opacity": "{sys.opacity.overlay}",
      "border-radius": "{sys.rounded.full}",
      "paddingX": "{sys.spacing.xs}",
      "paddingY": "{sys.spacing.x}",
      "backdrop-filter": "{sys.blur.sm}",
      "#item": {
        "width": "{ref.spacing.2}",
        "height": "{ref.spacing.2}"
      }
    },
    "~lines": {
      "#item": {
        "width": "{ref.spacing.6}",
        "height": "{ref.spacing.1}"
      }
    },
    "~progressbar": {
      "#progress": {
        "min-width": "{ref.spacing.32}"
      }
    }
  },
  "~vertical": {},
  "~dynamic": {},
  "@@palette": "{palette}"
}