{
  "name": "@dxtmisha/test",
  "private": false,
  "version": "0.1.9",
  "type": "module",
  "description": "Modular Vue 3 UI testing and documentation harness library — structured test containers, visual regression utilities, composition API helpers, and interactive wiki documentation components.",
  "keywords": [
    "vue",
    "vue3",
    "testing",
    "test-harness",
    "visual-regression",
    "wiki",
    "documentation",
    "components",
    "typescript",
    "dxt",
    "ui"
  ],
  "author": "dxtmisha@gmail.com",
  "license": "MIT",
  "homepage": "https://github.com/dxtmisha/dxt-ui/tree/main/packages/test",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dxtmisha/dxt-ui.git",
    "directory": "packages/test"
  },
  "bugs": {
    "url": "https://github.com/dxtmisha/dxt-ui/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "library": "dxt-library",
    "prepublishOnly": "dxt-library && npm run build",
    "publish-to-npm": "npm publish --access public"
  },
  "files": [
    "dist",
    "README.md",
    "package.json",
    "LICENSE"
  ],
  "main": "dist/library.js",
  "module": "dist/library.js",
  "types": "dist/library.d.ts",
  "exports": {
    ".": {
      "types": "./dist/library.d.ts",
      "import": "./dist/library.js"
    },
    "./style.css": "./dist/style.css"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@dxtmisha/functional": ">=2.1.0",
    "@dxtmisha/functional-basic": ">=2.1.4",
    "@dxtmisha/styles": ">=1.0.14",
    "@dxtmisha/wiki": ">=1.2.0",
    "vue": ">=3.5.45"
  },
  "devDependencies": {},
  "ui-priority": 450
}