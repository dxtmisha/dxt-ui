{
  "name": "@dxtmisha/wiki",
  "private": false,
  "version": "0.113.1",
  "type": "module",
  "description": "Storybook documentation toolkit, component metadata registry, and MDX documentation system for DXT UI design system",
  "keywords": [
    "vue",
    "vue3",
    "storybook",
    "wiki",
    "documentation",
    "mdx",
    "dxt",
    "dxt-ui",
    "design-system",
    "component-metadata",
    "argtypes",
    "typescript",
    "react"
  ],
  "author": "dxtmisha@gmail.com",
  "license": "MIT",
  "homepage": "https://github.com/dxtmisha/dxt-ui/tree/main/packages/wiki",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dxtmisha/dxt-ui.git",
    "directory": "packages/wiki"
  },
  "bugs": {
    "url": "https://github.com/dxtmisha/dxt-ui/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "prepublishOnly": "npm run build",
    "publish-to-npm": "npm publish --access public"
  },
  "files": [
    "dist",
    "src/styles",
    "README.md",
    "package.json",
    "LICENSE"
  ],
  "main": "dist/library.js",
  "module": "dist/library.js",
  "types": "dist/library.d.ts",
  "exports": {
    ".": {
      "import": "./dist/library.js",
      "types": "./dist/library.d.ts"
    },
    "./functional/*": "./src/media/functional/*.mdx",
    "./media": {
      "import": "./dist/media.js",
      "types": "./dist/media.d.ts"
    },
    "./storybook": {
      "import": "./dist/storybook.js",
      "types": "./dist/storybook.d.ts"
    },
    "./storybook/styles": "./src/styles/storybookStyle.scss"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@dxtmisha/functional": ">=1.15.15",
    "@dxtmisha/functional-basic": ">=1.10.1",
    "@dxtmisha/styles": ">=1.0.12",
    "@storybook/addon-docs": ">=10.5.10",
    "react": ">=19.2.8",
    "vue": ">=3.5.42"
  },
  "ui-priority": 400
}