{
  "name": "@dxtmisha/configuration",
  "private": false,
  "version": "1.0.2",
  "type": "module",
  "description": "Shared configuration files for DXT UI - Vite configs and TypeScript configs for building UI components",
  "keywords": [
    "vite",
    "typescript",
    "config",
    "tsconfig",
    "ui",
    "dxt",
    "build",
    "configuration"
  ],
  "author": "dxtmisha@gmail.com",
  "license": "MIT",
  "homepage": "https://github.com/dxtmisha/dxt-ui/tree/main/packages/configuration",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dxtmisha/dxt-ui.git",
    "directory": "packages/configuration"
  },
  "bugs": {
    "url": "https://github.com/dxtmisha/dxt-ui/issues"
  },
  "scripts": {
    "publish-to-npm": "npm publish --access public"
  },
  "files": [
    "classes/",
    "functions/",
    "tsconfig/",
    "viteconfig/",
    "README.md",
    "package.json",
    "tsconfig.app.json",
    "LICENSE"
  ],
  "exports": {
    "./tsconfig/*": "./tsconfig/*",
    "./viteBasic": {
      "types": "./viteconfig/viteBasic.config.d.ts",
      "default": "./viteconfig/viteBasic.config.js"
    },
    "./viteBasicFunction": {
      "types": "./viteconfig/viteBasicFunction.config.d.ts",
      "default": "./viteconfig/viteBasicFunction.config.js"
    },
    "./viteComponents": {
      "types": "./viteconfig/viteComponents.config.d.ts",
      "default": "./viteconfig/viteComponents.config.js"
    },
    "./viteConstructors": {
      "types": "./viteconfig/viteConstructors.config.d.ts",
      "default": "./viteconfig/viteConstructors.config.js"
    },
    "./viteFigma": {
      "types": "./viteconfig/viteFigma.config.d.ts",
      "default": "./viteconfig/viteFigma.config.js"
    },
    "./viteFlags": {
      "types": "./viteconfig/viteFlags.config.d.ts",
      "default": "./viteconfig/viteFlags.config.js"
    },
    "./viteLibrariesRollup": {
      "types": "./viteconfig/viteLibrariesRollup.config.d.ts",
      "default": "./viteconfig/viteLibrariesRollup.config.js"
    },
    "./viteMdx": {
      "types": "./viteconfig/viteMdx.config.d.ts",
      "default": "./viteconfig/viteMdx.config.js"
    },
    "./vitePluginComponents": {
      "types": "./functions/vitePluginComponents.d.ts",
      "default": "./functions/vitePluginComponents.js"
    },
    "./vitePluginLibrary": {
      "types": "./functions/vitePluginLibrary.d.ts",
      "default": "./functions/vitePluginLibrary.js"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@mdx-js/rollup": ">=3.1.1",
    "@microsoft/api-extractor": ">=7.59.0",
    "@vitejs/plugin-vue": ">=6.0.8",
    "browserslist": ">=4.28.8",
    "lightningcss": ">=1.33.0",
    "typescript": ">=6.0.3",
    "vite": ">=8.2.2",
    "vite-plugin-dts": ">=5.0.3",
    "vite-plugin-singlefile": ">=2.3.3"
  },
  "ui-test": true
}