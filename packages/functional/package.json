{
  "name": "@dxtmisha/functional",
  "private": false,
  "version": "1.15.13",
  "type": "module",
  "description": "A comprehensive library of utilities, base classes, and Vue 3 composables for reactive web development — API orchestration, state singletons (executeUse), storage sync, i18n, formatters, and component design. Extends @dxtmisha/functional-basic.",
  "keywords": [
    "vue",
    "vue3",
    "composition-api",
    "composables",
    "reactivity",
    "typescript",
    "utilities",
    "helpers",
    "functional",
    "ssr",
    "hydration",
    "api-client",
    "execute-use",
    "singletons",
    "state-management",
    "design-constructor",
    "base-classes",
    "storage",
    "localStorage",
    "sessionStorage",
    "cookie",
    "broadcast-channel",
    "i18n",
    "intl",
    "localization",
    "translate",
    "geo",
    "geolocation",
    "flags",
    "datetime",
    "formatters",
    "units",
    "meta",
    "seo",
    "dom",
    "events",
    "list-data",
    "search",
    "lazy-loading",
    "computed-async",
    "router",
    "dxt"
  ],
  "author": "dxtmisha@gmail.com",
  "license": "MIT",
  "homepage": "https://github.com/dxtmisha/dxt-ui/tree/main/packages/functional",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dxtmisha/dxt-ui.git",
    "directory": "packages/functional"
  },
  "bugs": {
    "url": "https://github.com/dxtmisha/dxt-ui/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "NODE_OPTIONS=\"--no-webstorage\" vitest",
    "library": "dxt-library",
    "types": "npm run library && npm run build && dxt-types",
    "prepublishOnly": "npm run library && npm run build && dxt-types-save",
    "publish-to-npm": "npm publish --access public"
  },
  "files": [
    "ai-resources",
    "dist",
    "ai-description.md",
    "ai-doc.md",
    "ai-mcp-resources.json",
    "ai-types.md",
    "CHANGELOG.md",
    "LICENSE",
    "package.json",
    "README.md"
  ],
  "main": "dist/library.js",
  "module": "dist/library.js",
  "types": "dist/library.d.ts",
  "exports": {
    ".": {
      "import": "./dist/library.js",
      "types": "./dist/library.d.ts"
    },
    "./flags": {
      "import": "./dist/flags.js",
      "types": "./dist/flags.d.ts"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@dxtmisha/media": "*",
    "@dxtmisha/functional-basic": "*",
    "vue": "*"
  },
  "sideEffects": false,
  "ui-priority": 200
}