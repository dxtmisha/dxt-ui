{
  "name": "@dxtmisha/zip",
  "private": false,
  "version": "0.1.3",
  "type": "module",
  "description": "Library for creating and managing ZIP archives in the browser and Node.js environments.",
  "keywords": [
    "zip",
    "fflate",
    "archive",
    "browser",
    "frontend-utils"
  ],
  "author": "dxtmisha@gmail.com",
  "license": "MIT",
  "homepage": "https://github.com/dxtmisha/dxt-ui/tree/main/packages/zip",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dxtmisha/dxt-ui.git",
    "directory": "packages/zip"
  },
  "bugs": {
    "url": "https://github.com/dxtmisha/dxt-ui/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "NODE_OPTIONS=\"--no-webstorage\" vitest",
    "library": "dxt-library",
    "types": "npm run library && npm run build && dxt-types",
    "prepublishOnly": "npm run library && npm run build && dxt-types-save",
    "publish-to-npm": "npm publish --access public"
  },
  "files": [
    "ai-resources",
    "ai-screenshot",
    "dist",
    "ai-description.md",
    "ai-doc.md",
    "ai-mcp-resources.json",
    "ai-types.md",
    "CHANGELOG.md",
    "LICENSE",
    "package.json",
    "README.md"
  ],
  "main": "dist/library.js",
  "module": "dist/library.js",
  "types": "dist/library.d.ts",
  "exports": {
    ".": {
      "import": "./dist/library.js",
      "types": "./dist/library.d.ts"
    },
    "./ai-types.md": "./ai-types.md",
    "./ai-description.md": "./ai-description.md",
    "./ai-resources/*": "./ai-resources/*",
    "./ai-screenshot/*": "./ai-screenshot/*"
  },
  "dependencies": {
    "@dxtmisha/functional-basic": "*",
    "fflate": "*"
  },
  "devDependencies": {},
  "sideEffects": false,
  "ui-priority": 450
}