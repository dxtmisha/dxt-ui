{
  "name": "@dxtmisha/demo-mcp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "[description]",
  "scripts": {
    "start": "vite-node bin/demo-mcp.ts",
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "component": "dxt-component",
    "library": "dxt-library",
    "types": "npm run library && npm run build && dxt-types",
    "screenshot": "dxt-screenshot",
    "wiki": "dxt-ai-doc",
    "prepublishOnly": "npm run library && npm run build && dxt-types-save",
    "publish-to-npm": "npm publish --access public"
  },
  "bin": {
    "dxt-demo-mcp": "bin/demo-mcp.ts"
  },
  "files": [
    "bin/",
    "ai-resources/",
    "ai-screenshot/",
    "dist",
    "ai-description.md",
    "ai-doc.md",
    "ai-mcp-resources.json",
    "ai-types.md",
    "CHANGELOG.md",
    "LICENSE",
    "package.json",
    "README.md"
  ],
  "main": "dist/library.js",
  "module": "dist/library.js",
  "types": "dist/library.d.ts",
  "exports": {
    ".": {
      "import": "./dist/library.js",
      "types": "./dist/library.d.ts"
    },
    "./style.css": "./dist/style.css"
  },
  "dependencies": {
    "@dxtmisha/functional-basic": "*",
    "@dxtmisha/mcp": "*"
  },
  "devDependencies": {},
  "sideEffects": false
}