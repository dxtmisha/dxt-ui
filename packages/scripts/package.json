{
  "name": "@dxtmisha/scripts",
  "private": false,
  "version": "0.10.16",
  "type": "module",
  "description": "CLI tools, AI integration scripts, and automation utilities for DXT UI — automated component scaffolding, Figma layout generation, library packaging, documentation building, screenshot captures, and AI prompt processing.",
  "keywords": [
    "cli",
    "scripts",
    "automation",
    "generators",
    "scaffolding",
    "build-tools",
    "component-generator",
    "figma-sync",
    "ai-tools",
    "ai-resources",
    "storybook",
    "documentation",
    "typescript",
    "vue",
    "dxt",
    "dxt-ui"
  ],
  "author": "dxtmisha@gmail.com",
  "license": "MIT",
  "homepage": "https://github.com/dxtmisha/dxt-ui/tree/main/packages/scripts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dxtmisha/dxt-ui.git",
    "directory": "packages/scripts"
  },
  "bugs": {
    "url": "https://github.com/dxtmisha/dxt-ui/issues"
  },
  "scripts": {
    "library": "dxt-library",
    "publish-to-npm": "npm publish --access public"
  },
  "files": [
    "bin/",
    "src/",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "package.json"
  ],
  "main": "./src/library.ts",
  "module": "./src/library.ts",
  "bin": {
    "dxt-ai-doc": "bin/ai-doc.ts",
    "dxt-build-functional": "bin/build-functional.ts",
    "dxt-build-packages": "bin/build-packages.ts",
    "dxt-build-publish-packages": "bin/build-publish-packages.ts",
    "dxt-component": "bin/design-component.ts",
    "dxt-component-wiki": "bin/design-component-wiki.ts",
    "dxt-constructor": "bin/design-constructor.ts",
    "dxt-figma-layout": "bin/design-figma.ts",
    "dxt-flags": "bin/design-flags.ts",
    "dxt-library": "bin/design-library.ts",
    "dxt-package": "bin/design-package.ts",
    "dxt-prompt": "bin/design-prompt.ts",
    "dxt-screenshot": "bin/design-screenshot.ts",
    "dxt-types": "bin/design-types.ts",
    "dxt-ui": "bin/design-ui.ts",
    "dxt-wiki-storm": "bin/design-wiki-storm.ts"
  },
  "exports": {
    ".": "./src/library.ts",
    "./ai": "./src/library-ai.ts",
    "./plugin": "./src/library-plugin.ts",
    "./config": "./src/config.ts",
    "./properties.json": "./src/media/properties.json"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@ai-sdk/xai": "*",
    "@anthropic-ai/claude-agent-sdk": "*",
    "@anthropic-ai/sdk": "*",
    "@dxtmisha/functional": "*",
    "@dxtmisha/functional-basic": "*",
    "@dxtmisha/media": "*",
    "@google/genai": "*",
    "@napi-rs/canvas": "*",
    "ai": "*",
    "openai": "*",
    "puppeteer": "*",
    "sass": "*",
    "typescript": "*",
    "vite-node": "*",
    "vue": "*"
  },
  "devDependencies": {
    "@dxtmisha/wiki": "*"
  }
}