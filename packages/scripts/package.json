{
  "name": "@dxtmisha/scripts",
  "private": false,
  "version": "1.0.0",
  "type": "module",
  "description": "CLI tools, AI integration scripts, and automation utilities for DXT UI — automated component scaffolding, Figma layout generation, library packaging, documentation building, screenshot captures, and AI prompt processing.",
  "keywords": [
    "cli",
    "scripts",
    "automation",
    "generators",
    "scaffolding",
    "build-tools",
    "component-generator",
    "figma-sync",
    "ai-tools",
    "ai-resources",
    "storybook",
    "documentation",
    "typescript",
    "vue",
    "dxt",
    "dxt-ui"
  ],
  "author": "dxtmisha@gmail.com",
  "license": "MIT",
  "homepage": "https://github.com/dxtmisha/dxt-ui/tree/main/packages/scripts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dxtmisha/dxt-ui.git",
    "directory": "packages/scripts"
  },
  "bugs": {
    "url": "https://github.com/dxtmisha/dxt-ui/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "prepublishOnly": "npm run build",
    "publish-to-npm": "npm publish --access public"
  },
  "files": [
    "bin/",
    "dist/",
    "src/media/properties.json",
    "ai-resources/",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "package.json"
  ],
  "main": "./dist/library.js",
  "module": "./dist/library.js",
  "types": "./dist/library.d.ts",
  "bin": {
    "dxt-build-packages": "bin/build-packages.js",
    "dxt-build-publish-packages": "bin/build-publish-packages.js",
    "dxt-component": "bin/design-component.js",
    "dxt-constructor": "bin/design-constructor.js",
    "dxt-figma-layout": "bin/design-figma.js",
    "dxt-flags": "bin/design-flags.js",
    "dxt-library": "bin/design-library.js",
    "dxt-package": "bin/design-package.js",
    "dxt-prompt": "bin/design-prompt.js",
    "dxt-screenshot": "bin/design-screenshot.js",
    "dxt-types": "bin/design-types.js",
    "dxt-types-save": "bin/design-types-save.js",
    "dxt-ui": "bin/design-ui.js",
    "dxt-wiki-storm": "bin/design-wiki-storm.js"
  },
  "exports": {
    ".": {
      "types": "./dist/library.d.ts",
      "default": "./dist/library.js"
    },
    "./ai": {
      "types": "./dist/library-ai.d.ts",
      "default": "./dist/library-ai.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./properties.json": "./src/media/properties.json"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@dxtmisha/functional": "*",
    "@dxtmisha/functional-basic": "*",
    "@dxtmisha/media": "*",
    "sass": "*",
    "typescript": "*",
    "vite-node": "*",
    "vue": "*"
  },
  "devDependencies": {
    "puppeteer": "*"
  },
  "peerDependencies": {
    "@ai-sdk/xai": "*",
    "@anthropic-ai/claude-agent-sdk": "*",
    "@anthropic-ai/sdk": "*",
    "@dxtmisha/wiki": "*",
    "@google/genai": "*",
    "@napi-rs/canvas": "*",
    "ai": "*",
    "openai": "*",
    "puppeteer": "*"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/xai": {
      "optional": true
    },
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    },
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "@dxtmisha/wiki": {
      "optional": true
    },
    "@google/genai": {
      "optional": true
    },
    "@napi-rs/canvas": {
      "optional": true
    },
    "ai": {
      "optional": true
    },
    "openai": {
      "optional": true
    },
    "puppeteer": {
      "optional": true
    }
  }
}