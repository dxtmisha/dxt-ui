{
  "name": "@dxtmisha/media",
  "private": false,
  "version": "0.8.0",
  "type": "module",
  "description": "Media resources, vector icon libraries, and geographical datasets for DXT UI — file classification, social networks, country flags, and ISO 3166-1 country metadata. Framework-agnostic, tree-shakeable, zero dependencies.",
  "keywords": [
    "media",
    "files",
    "file-icons",
    "file-types",
    "mime-types",
    "socials",
    "social-icons",
    "social-networks",
    "flags",
    "country-flags",
    "svg-flags",
    "countries",
    "geo",
    "geographical-data",
    "iso-3166",
    "phone-codes",
    "phone-masks",
    "timezones",
    "i18n",
    "localization",
    "tree-shakeable",
    "dxt",
    "ui"
  ],
  "author": "dxtmisha@gmail.com",
  "license": "MIT",
  "homepage": "https://github.com/dxtmisha/dxt-ui/tree/main/packages/media",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dxtmisha/dxt-ui.git",
    "directory": "packages/media"
  },
  "bugs": {
    "url": "https://github.com/dxtmisha/dxt-ui/issues"
  },
  "files": [
    "dist",
    "README.md",
    "package.json",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "flags": "dxt-flags",
    "test": "vitest",
    "prepublishOnly": "npm run build",
    "publish-to-npm": "npm publish --access public"
  },
  "main": "dist/library.js",
  "module": "dist/library.js",
  "types": "./dist/library.d.ts",
  "exports": {
    ".": {
      "import": "./dist/library.js",
      "types": "./dist/library.d.ts"
    },
    "./files": {
      "import": "./dist/files.js",
      "types": "./dist/files.d.ts"
    },
    "./flags": {
      "import": "./dist/flags.js",
      "types": "./dist/flags.d.ts"
    },
    "./socials": {
      "import": "./dist/socials.js",
      "types": "./dist/socials.d.ts"
    },
    "./flags.webp": "./dist/flags.webp",
    "./style.css": "./dist/style.css",
    "./types/*": "./dist/*",
    "./types/**/*.d.ts": "./dist/**/*.d.ts"
  },
  "dependencies": {},
  "engines": {
    "node": ">=20.0.0"
  },
  "ui-priority": 50
}