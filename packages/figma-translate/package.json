{
  "name": "@dxtmisha/figma-translate",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "[description]",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build --mode ui && vite build --mode code",
    "build:ui:watch": "vue-tsc -b && vite build --mode ui --watch",
    "build:code:watch": "vue-tsc -b && vite build --mode code --watch",
    "preview": "vite preview",
    "test": "vitest",
    "component": "dxt-component",
    "library": "dxt-library"
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "main": "dist/library.js",
  "module": "dist/library.js",
  "types": "dist/library.d.ts",
  "exports": {
    ".": {
      "import": "./dist/library.js",
      "types": "./dist/library.d.ts"
    },
    "./style.css": "./dist/style.css",
    "./types/*": "./dist/*",
    "./types/**/*.d.ts": "./dist/**/*.d.ts"
  },
  "dependencies": {
    "@dxtmisha/constructor": ">=0.113.0",
    "@dxtmisha/d1": ">=0.113.0",
    "@dxtmisha/figma": ">=0.1.4",
    "@dxtmisha/figma-code": ">=0.1.3",
    "@dxtmisha/figma-ref": ">=0.1.3",
    "@dxtmisha/functional": ">=1.15.15",
    "@dxtmisha/functional-basic": ">=1.10.1",
    "vue": ">=3.5.42"
  },
  "devDependencies": {},
  "ui-test": true
}
