{
  "name": "@dxtmisha/styles",
  "private": false,
  "version": "1.0.12",
  "type": "module",
  "description": "SCSS styles and utilities for DXT UI design system",
  "keywords": [
    "scss",
    "styles",
    "css",
    "design-system",
    "ui",
    "dxt",
    "mixins",
    "utilities"
  ],
  "author": "dxtmisha@gmail.com",
  "license": "MIT",
  "homepage": "https://github.com/dxtmisha/dxt-ui/tree/main/packages/styles",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dxtmisha/dxt-ui.git",
    "directory": "packages/styles"
  },
  "bugs": {
    "url": "https://github.com/dxtmisha/dxt-ui/issues"
  },
  "scripts": {
    "types": "dxt-types",
    "publish-to-npm": "npm publish --access public"
  },
  "files": [
    "ai-resources/",
    "ai-screenshot/",
    "src/styles",
    "ai-description.md",
    "ai-doc.md",
    "ai-mcp-resources.json",
    "index.scss",
    "properties.scss",
    "README.md",
    "package.json",
    "LICENSE"
  ],
  "main": "src/styles/index.scss",
  "exports": {
    ".": {
      "sass": "./src/styles/index.scss"
    },
    "./properties": {
      "sass": "./src/styles/properties/index.scss"
    },
    "./ai-types.md": "./ai-types.md",
    "./ai-description.md": "./ai-description.md",
    "./ai-resources/*": "./ai-resources/*",
    "./ai-screenshot/*": "./ai-screenshot/*"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "peerDependencies": {
    "sass": ">=1.103.1"
  },
  "peerDependenciesMeta": {
    "sass": {
      "optional": false
    }
  },
  "ui-test": true
}
