{
  "name": "dxt-ui",
  "private": false,
  "version": "0.1.5",
  "description": "A modular Vue 3 UI library and design system constructor featuring AI-automated documentation, TypeScript support, and a flexible component architecture.",
  "keywords": [
    "vue",
    "vue3",
    "ui",
    "ui-library",
    "component-library",
    "design-system",
    "typescript",
    "vite",
    "storybook",
    "frontend",
    "scss"
  ],
  "type": "module",
  "author": "dxtmisha@gmail.com",
  "license": "MIT",
  "homepage": "https://github.com/dxtmisha/dxt-ui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dxtmisha/dxt-ui.git"
  },
  "bugs": {
    "url": "https://github.com/dxtmisha/dxt-ui/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "package-library": "dxt-package library",
    "package-project": "dxt-package project",
    "package-figma": "dxt-package figma",
    "build-packages": "dxt-build-packages --date",
    "build-types": "dxt-build-packages --code=types --log=types",
    "build-publish-packages": "dxt-build-publish-packages",
    "prompt": "dxt-prompt --vue",
    "prepublishOnly": "npm run build",
    "postinstall": "npm run prompt"
  },
  "files": [
    "packages/demo-mcp/dist",
    "packages/demo-mcp/package.json",
    "packages/mcp/dist",
    "packages/mcp/package.json",
    "packages/zip/dist",
    "packages/zip/package.json",
    "dist",
    "src/style.scss",
    "README.md",
    "package.json",
    "LICENSE"
  ],
  "exports": {
    "./demo-mcp": {
      "import": "./dist/demo-mcp.js",
      "types": "./dist/demo-mcp.d.ts"
    },
    "./mcp": {
      "import": "./dist/mcp.js",
      "types": "./dist/mcp.d.ts"
    },
    "./zip": {
      "import": "./dist/zip.js",
      "types": "./dist/zip.d.ts"
    },
    "./functional": {
      "import": "./dist/functional.js",
      "types": "./dist/functional.d.ts"
    },
    "./media": {
      "import": "./dist/media.js",
      "types": "./dist/media.d.ts"
    },
    "./style.css": "./dist/style.css",
    "./scss": "./src/style.scss",
    "./types/*": "./dist/*"
  },
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "@dxtmisha/configuration": ">=1.2.0",
    "@dxtmisha/constructor": ">=0.118.3",
    "@dxtmisha/demo-mcp": ">=0.0.0",
    "@dxtmisha/figma": ">=0.1.4",
    "@dxtmisha/figma-code": ">=0.1.4",
    "@dxtmisha/figma-ref": ">=0.1.3",
    "@dxtmisha/functional": ">=1.15.18",
    "@dxtmisha/functional-basic": ">=1.11.2",
    "@dxtmisha/mcp": ">=0.1.1",
    "@dxtmisha/media": ">=0.8.1",
    "@dxtmisha/nitro-basic": ">=0.1.19",
    "@dxtmisha/scripts": ">=1.5.6",
    "@dxtmisha/styles": ">=1.0.13",
    "@dxtmisha/wiki": ">=0.118.1",
    "sass": "^1.105.1",
    "typescript": "^6.0.3",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@ai-sdk/xai": "^5.0.20",
    "@anthropic-ai/claude-agent-sdk": "^0.3.295",
    "@anthropic-ai/sdk": "^0.133.0",
    "@dxtmisha/d1": ">=0.118.0",
    "@dxtmisha/demo": ">=0.0.1",
    "@dxtmisha/figma-style": ">=1.0.1",
    "@dxtmisha/figma-translate": ">=0.0.0",
    "@dxtmisha/storybook": ">=0.110.0",
    "@dxtmisha/test": ">=0.1.8",
    "@dxtmisha/zip": ">=0.1.5",
    "@eslint/js": "^10.0.1",
    "@figma/plugin-typings": "^1.141.0",
    "@google/genai": "^2.28.0",
    "@mdx-js/rollup": "^3.1.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@napi-rs/canvas": "^1.0.10",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-vitest": "^10.6.1",
    "@storybook/vue3-vite": "^10.6.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.6.4",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/language-core": "^3.3.12",
    "@vue/tsconfig": "^0.9.1",
    "ai": "^7.0.137",
    "browserslist": "^4.29.3",
    "commander": "^15.0.0",
    "dotenv": "^18.0.7",
    "eslint": "^10.12.0",
    "eslint-plugin-storybook": "^10.6.1",
    "eslint-plugin-vue": "^10.11.1",
    "fflate": "^0.8.3",
    "glob": "^13.0.6",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "lightningcss": "^1.33.0",
    "nitro": "^3.0.260903-beta",
    "openai": "^7.31.0",
    "storybook": "^10.6.1",
    "typescript-eslint": "^8.71.1",
    "unctx": "^3.0.1",
    "vite": "^8.3.4",
    "vite-node": "^6.0.0",
    "vite-plugin-css-injected-by-js": "^5.0.2",
    "vite-plugin-dts": "^5.1.2",
    "vite-plugin-singlefile": "^2.3.3",
    "vite-plugin-svg-loader": "^1.0.0",
    "vitest": "^5.0.3",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.12",
    "zod": "^4.6.5"
  }
}
