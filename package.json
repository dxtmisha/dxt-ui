{
  "name": "dxt-ui",
  "private": false,
  "version": "0.1.5",
  "description": "A modular Vue 3 UI library and design system constructor featuring AI-automated documentation, TypeScript support, and a flexible component architecture.",
  "keywords": [
    "vue",
    "vue3",
    "ui",
    "ui-library",
    "component-library",
    "design-system",
    "typescript",
    "vite",
    "storybook",
    "frontend",
    "scss"
  ],
  "type": "module",
  "author": "dxtmisha@gmail.com",
  "license": "MIT",
  "homepage": "https://github.com/dxtmisha/dxt-ui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dxtmisha/dxt-ui.git"
  },
  "bugs": {
    "url": "https://github.com/dxtmisha/dxt-ui/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "package-library": "dxt-package --type library",
    "package-project": "dxt-package project",
    "package-figma": "dxt-package figma",
    "build-packages": "dxt-build-packages --date",
    "build-types": "dxt-build-packages --code=types --log=types",
    "build-publish-packages": "dxt-build-publish-packages",
    "prompt": "dxt-prompt --vue",
    "prepublishOnly": "npm run build",
    "postinstall": "npm run prompt"
  },
  "files": [
    "packages/cms-api/dist",
    "packages/cms-api/package.json",
    "packages/cms/dist",
    "packages/cms/package.json",
    "packages/demo-mcp/dist",
    "packages/demo-mcp/package.json",
    "packages/mcp/dist",
    "packages/mcp/package.json",
    "packages/zip/dist",
    "packages/zip/package.json",
    "dist",
    "src/style.scss",
    "README.md",
    "package.json",
    "LICENSE"
  ],
  "exports": {
    "./cms-api": {
      "import": "./dist/cms-api.js",
      "types": "./dist/cms-api.d.ts"
    },
    "./cms": {
      "import": "./dist/cms.js",
      "types": "./dist/cms.d.ts"
    },
    "./demo-mcp": {
      "import": "./dist/demo-mcp.js",
      "types": "./dist/demo-mcp.d.ts"
    },
    "./mcp": {
      "import": "./dist/mcp.js",
      "types": "./dist/mcp.d.ts"
    },
    "./zip": {
      "import": "./dist/zip.js",
      "types": "./dist/zip.d.ts"
    },
    "./functional": {
      "import": "./dist/functional.js",
      "types": "./dist/functional.d.ts"
    },
    "./media": {
      "types": "./dist/library/media.d.ts",
      "default": "./dist/library/media.js"
    },
    "./style.css": "./dist/styles/Ui/main.css",
    "./scss": "./src/style.scss",
    "./types/*": "./dist/*",
    "./UiImage": {
      "types": "./dist/library/UiImage.d.ts",
      "default": "./dist/library/UiImage.js"
    },
    ".": {
      "types": "./dist/library/types.d.ts",
      "default": "./dist/library/types.js"
    },
    "./plugin": {
      "types": "./dist/library/plugin.d.ts",
      "default": "./dist/library/plugin.js"
    },
    "./style/ui.scss": "./src/styles/Ui/main.scss",
    "./ui-properties": {
      "sass": "./ui-properties.scss",
      "default": "./ui-properties.scss"
    },
    "./types.d.ts": "./dist/library/types.d.ts"
  },
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "@microsoft/api-extractor": "^7.60.1"
  },
  "dependencies": {
    "@dxtmisha/cms-api": "workspace:*",
    "@dxtmisha/cms": "workspace:*",
    "@dxtmisha/configuration": ">=1.2.0",
    "@dxtmisha/constructor": ">=0.118.3",
    "@dxtmisha/demo-mcp": ">=0.0.0",
    "@dxtmisha/figma": ">=0.1.4",
    "@dxtmisha/figma-code": ">=0.1.4",
    "@dxtmisha/figma-ref": ">=0.1.3",
    "@dxtmisha/functional": ">=1.16.0",
    "@dxtmisha/functional-basic": ">=1.14.0",
    "@dxtmisha/mcp": ">=0.1.1",
    "@dxtmisha/media": ">=0.8.1",
    "@dxtmisha/nitro-basic": ">=0.1.19",
    "@dxtmisha/scripts": ">=1.5.6",
    "@dxtmisha/styles": ">=1.0.14",
    "@dxtmisha/wiki": ">=0.118.1",
    "sass": "^1.108.2",
    "typescript": "^6.0.3",
    "vue": "^3.5.45",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@ai-sdk/xai": "^5.0.46",
    "@anthropic-ai/claude-agent-sdk": "^0.3.325",
    "@anthropic-ai/sdk": "^1.8.0",
    "@dxtmisha/d1": ">=0.118.0",
    "@dxtmisha/demo": ">=0.0.1",
    "@dxtmisha/figma-style": ">=1.0.1",
    "@dxtmisha/figma-translate": ">=0.0.0",
    "@dxtmisha/storybook": ">=0.110.0",
    "@dxtmisha/test": ">=0.1.8",
    "@dxtmisha/zip": ">=0.1.5",
    "@eslint/js": "^10.0.1",
    "@figma/plugin-typings": "^1.142.0",
    "@google/genai": "^3.3.0",
    "@mdx-js/rollup": "^3.1.1",
    "@microsoft/api-extractor": "^7.60.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@napi-rs/canvas": "^1.1.1",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/addon-vitest": "^10.6.7",
    "@storybook/vue3-vite": "^10.6.7",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/language-core": "^3.3.14",
    "@vue/tsconfig": "^0.9.1",
    "ai": "^7.0.173",
    "browserslist": "^4.29.5",
    "commander": "^15.1.0",
    "dotenv": "^18.0.10",
    "eslint": "^10.15.0",
    "eslint-plugin-storybook": "^10.6.7",
    "eslint-plugin-vue": "^10.12.1",
    "fflate": "^0.8.3",
    "glob": "^14.0.6",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "lightningcss": "^1.33.0",
    "nitro": "^3.0.261103-rc",
    "openai": "^7.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.7",
    "typescript-eslint": "^8.72.2",
    "unctx": "^3.0.1",
    "vite": "^8.3.8",
    "vite-node": "^6.0.0",
    "vite-plugin-css-injected-by-js": "^5.0.3",
    "vite-plugin-dts": "^5.1.2",
    "vite-plugin-singlefile": "^2.3.4",
    "vite-plugin-svg-loader": "^1.0.0",
    "vitest": "^5.1.0",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^3.3.14",
    "zod": "^4.6.7"
  },
  "web-types": "./dist/web-types.json",
  "main": "./dist/library/types.js",
  "module": "./dist/library/types.js",
  "types": "./dist/library/types.d.ts",
  "sideEffects": [
    "*.css",
    "*.scss",
    "**/*.css",
    "**/*.scss"
  ]
}