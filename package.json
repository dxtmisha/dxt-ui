{
  "name": "dxt-ui",
  "private": false,
  "version": "0.1.5",
  "description": "A modular Vue 3 UI library and design system constructor featuring AI-automated documentation, TypeScript support, and a flexible component architecture.",
  "keywords": [
    "vue",
    "vue3",
    "ui",
    "ui-library",
    "component-library",
    "design-system",
    "typescript",
    "vite",
    "storybook",
    "frontend",
    "scss"
  ],
  "type": "module",
  "author": "dxtmisha@gmail.com",
  "license": "MIT",
  "homepage": "https://github.com/dxtmisha/dxt-ui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dxtmisha/dxt-ui.git"
  },
  "bugs": {
    "url": "https://github.com/dxtmisha/dxt-ui/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "package-library": "dxt-package library",
    "package-project": "dxt-package project",
    "package-figma": "dxt-package figma",
    "build-functional": "dxt-build-functional",
    "build-packages": "dxt-build-packages",
    "build-publish-packages": "dxt-build-publish-packages",
    "prompt": "dxt-prompt 1",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "packages/mcp/dist",
    "packages/mcp/package.json",
    "packages/zip/dist",
    "packages/zip/package.json",
    "dist",
    "src/style.scss",
    "README.md",
    "package.json",
    "LICENSE"
  ],
  "exports": {
    "./mcp": {
      "import": "./dist/mcp.js",
      "types": "./dist/mcp.d.ts"
    },
    "./zip": {
      "import": "./dist/zip.js",
      "types": "./dist/zip.d.ts"
    },
    "./functional": {
      "import": "./dist/functional.js",
      "types": "./dist/functional.d.ts"
    },
    "./media": {
      "import": "./dist/media.js",
      "types": "./dist/media.d.ts"
    },
    "./style.css": "./dist/style.css",
    "./scss": "./src/style.scss",
    "./types/*": "./dist/*"
  },
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "@dxtmisha/mcp": "workspace:*",
    "@dxtmisha/configuration": "workspace:*",
    "@dxtmisha/constructor": "workspace:*",
    "@dxtmisha/figma": "workspace:*",
    "@dxtmisha/figma-code": "workspace:*",
    "@dxtmisha/figma-ref": "workspace:*",
    "@dxtmisha/functional": "workspace:*",
    "@dxtmisha/functional-basic": "workspace:*",
    "@dxtmisha/media": "workspace:*",
    "@dxtmisha/nitro-basic": "workspace:*",
    "@dxtmisha/scripts": "workspace:*",
    "@dxtmisha/styles": "workspace:*",
    "@dxtmisha/wiki": "workspace:*",
    "sass": "^1.102.0",
    "typescript": "^6.0.3",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@ai-sdk/xai": "^4.0.28",
    "ai": "^7.0.52",
    "zod": "^4.4.3",
    "@anthropic-ai/claude-agent-sdk": "^0.3.222",
    "@anthropic-ai/sdk": "^0.115.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@dxtmisha/d1": "workspace:*",
    "@dxtmisha/demo": "workspace:*",
    "@dxtmisha/figma-style": "workspace:*",
    "@dxtmisha/figma-translate": "workspace:*",
    "@dxtmisha/storybook": "workspace:*",
    "@dxtmisha/test": "workspace:*",
    "@dxtmisha/zip": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@figma/plugin-typings": "^1.132.0",
    "@google/genai": "^2.15.0",
    "@mdx-js/rollup": "^3.1.1",
    "@napi-rs/canvas": "^1.0.3",
    "@storybook/addon-a11y": "^10.5.6",
    "@storybook/addon-docs": "^10.5.6",
    "@storybook/addon-vitest": "^10.5.6",
    "@storybook/vue3-vite": "^10.5.6",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.1.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/language-core": "^3.3.9",
    "@vue/tsconfig": "^0.9.1",
    "browserslist": "^4.28.7",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.0",
    "eslint-plugin-storybook": "^10.5.6",
    "eslint-plugin-vue": "^10.10.0",
    "fflate": "^0.8.3",
    "glob": "^13.0.6",
    "globals": "^17.9.0",
    "jsdom": "^30.0.1",
    "lightningcss": "^1.33.0",
    "nitro": "^3.0.260610-beta",
    "openai": "^7.4.0",
    "storybook": "^10.5.6",
    "typescript-eslint": "^8.66.0",
    "unctx": "^3.0.0",
    "vite": "^8.2.0",
    "vite-node": "^6.0.0",
    "vite-plugin-dts": "^5.0.3",
    "vite-plugin-singlefile": "^2.3.3",
    "vite-plugin-svg-loader": "^1.0.0",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9"
  }
}